{
 "kind": "collection",
 "slug": "listing-todos",
 "label": "To-do list",
 "singular": "To-do",
 "group": "Properties",
 "useAsTitle": "title",
 "defaultColumns": [
  "listingName",
  "title",
  "category",
  "done",
  "sourceLinks",
  "updatedAt"
 ],
 "searchable": [],
 "description": "What is left to do on each listing. Tick the box to check a task off and it leaves this list.",
 "auth": false,
 "upload": false,
 "drafts": false,
 "scopedForDeveloper": true,
 "visible": {
  "admin": true,
  "developer": false
 },
 "access": {
  "read": "Admin only",
  "create": "Admin only",
  "update": "Admin only",
  "delete": "Admin only"
 },
 "fields": [
  {
   "name": "listingName",
   "label": "Listing",
   "type": "text",
   "required": false,
   "description": "Filled in automatically from the listing you pick.",
   "readOnly": true,
   "position": "sidebar"
  },
  {
   "name": "title",
   "label": "What needs doing",
   "type": "text",
   "required": true
  },
  {
   "name": "category",
   "label": "Category",
   "type": "select",
   "required": false,
   "options": [
    {
     "label": "Publishing",
     "value": "Publishing"
    },
    {
     "label": "Contact & WhatsApp",
     "value": "Contact & WhatsApp"
    },
    {
     "label": "Dates & construction",
     "value": "Dates & construction"
    },
    {
     "label": "Pricing & payment",
     "value": "Pricing & payment"
    },
    {
     "label": "Location & map",
     "value": "Location & map"
    },
    {
     "label": "Photos & media",
     "value": "Photos & media"
    },
    {
     "label": "Amenities & features",
     "value": "Amenities & features"
    },
    {
     "label": "Floor plans, units & plots",
     "value": "Floor plans, units & plots"
    },
    {
     "label": "Developer & people",
     "value": "Developer & people"
    },
    {
     "label": "Other",
     "value": "Other"
    }
   ]
  },
  {
   "name": "done",
   "label": "Done",
   "type": "checkbox",
   "required": false,
   "defaultValue": false
  },
  {
   "name": "listingType",
   "label": "Applies to",
   "type": "select",
   "required": true,
   "options": [
    {
     "label": "A project",
     "value": "project"
    },
    {
     "label": "A land listing",
     "value": "land"
    },
    {
     "label": "General (no single listing)",
     "value": "other"
    }
   ],
   "defaultValue": "project"
  },
  {
   "name": "project",
   "label": "Project",
   "type": "relationship",
   "required": false,
   "relationTo": [
    "projects"
   ],
   "condition": "data=>data?.listingType===\"project\""
  },
  {
   "name": "land",
   "label": "Land",
   "type": "relationship",
   "required": false,
   "relationTo": [
    "lands"
   ],
   "condition": "data=>data?.listingType===\"land\""
  },
  {
   "name": "sourceLinks",
   "label": "Links",
   "type": "textarea",
   "required": false,
   "description": "Where the information came from and where to look: one link per line."
  },
  {
   "name": "notes",
   "label": "Notes",
   "type": "textarea",
   "required": false
  },
  {
   "name": "doneAt",
   "label": "Checked off on",
   "type": "date",
   "required": false,
   "readOnly": true,
   "position": "sidebar"
  },
  {
   "name": "updatedAt",
   "label": "Updated At",
   "type": "date",
   "required": false,
   "hidden": true
  },
  {
   "name": "createdAt",
   "label": "Created At",
   "type": "date",
   "required": false,
   "hidden": true
  }
 ]
}