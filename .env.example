# ---- Mail client (inbox at /dashboard/inbox) ----------------------------------------------------------------------
# Google Workspace mail. Leave MAIL_MOCK_MODE=true until the Google keys below are filled in. In mock mode (or whenever a key is
# missing) the inbox shows realistic sample mail and nothing is sent to Google.
MAIL_MOCK_MODE=true

# One service account with domain-wide delegation (Admin console > Security > API controls > Domain-wide delegation,
# scope https://mail.google.com/). GOOGLE_MAIL_SA_KEY is the private_key from the JSON key; "\n" sequences are fine.
GOOGLE_MAIL_SA_EMAIL=
GOOGLE_MAIL_SA_KEY=
# The one real mailbox; the three addresses below are aliases of it.
GOOGLE_MAIL_PRIMARY=

# The three mailboxes shown in the inbox.
MAIL_ACCOUNT_NOREPLY=no-reply@lankanewhomes.com
MAIL_ACCOUNT_SUPPORT=support@lankanewhomes.com
MAIL_ACCOUNT_DEVELOPERS=developers@lankanewhomes.com

# Shared secret for the scheduled sync (/api/mail/sync, header x-mail-sync-secret) and the optional webhook
# (/api/mail/webhook?secret=...). Use a long random string. Vercel Cron and the Cloudflare cron can also use CRON_SECRET.
MAIL_SYNC_SECRET=

# Local development only: lets the mail UI preview work without logging in. Ignored in production builds.
# MAIL_DEV_BYPASS_AUTH=true

# Address the site's automatic emails (lead alerts, password reset, digests) come from. Use the plain address: the display name
# ("Notifications | LankaNewHomes") is added in code from src/lib/sender-names.ts. Set the same value on Cloudflare.
EMAIL_FROM=no-reply@lankanewhomes.com
