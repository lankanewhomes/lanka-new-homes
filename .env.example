# ---- Mail client (CMS inbox at /cms/mail) ------------------------------------------------------------------------
# Leave MAIL_MOCK_MODE=true until the Zoho credentials below are filled in. In mock mode (or whenever a credential is
# missing) the inbox shows realistic sample mail for all three mailboxes and nothing is sent to Zoho.
MAIL_MOCK_MODE=true

# Zoho OAuth 2.0 "Self Client" (https://api-console.zoho.com): see the "CMS mail client" section of README.md.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Your Zoho data centre. Examples:
#   US:     https://accounts.zoho.com        https://mail.zoho.com/api
#   EU:     https://accounts.zoho.eu         https://mail.zoho.eu/api
#   India:  https://accounts.zoho.in         https://mail.zoho.in/api
#   AU:     https://accounts.zoho.com.au     https://mail.zoho.com.au/api
#   Canada: https://accounts.zohocloud.ca    https://mail.zohocloud.ca/api
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api

# A Zoho login only sees its own mailbox. If no-reply@, support@ and developers@ are separate Zoho users, make one Self Client per mailbox
# (signed in as that mailbox) and set its keys with the suffix NOREPLY, SUPPORT or DEVELOPERS. Anything left out uses the shared keys above.
# ZOHO_CLIENT_ID_SUPPORT=
# ZOHO_CLIENT_SECRET_SUPPORT=
# ZOHO_REFRESH_TOKEN_SUPPORT=
# ZOHO_CLIENT_ID_DEVELOPERS=
# ZOHO_CLIENT_SECRET_DEVELOPERS=
# ZOHO_REFRESH_TOKEN_DEVELOPERS=
# ZOHO_CLIENT_ID_NOREPLY=
# ZOHO_CLIENT_SECRET_NOREPLY=
# ZOHO_REFRESH_TOKEN_NOREPLY=

# The three mailboxes shown in the inbox.
MAIL_ACCOUNT_NOREPLY=no-reply@lankanewhomes.com
MAIL_ACCOUNT_SUPPORT=support@lankanewhomes.com
MAIL_ACCOUNT_DEVELOPERS=developers@lankanewhomes.com

# Shared secret for the scheduled sync (/api/mail/sync, header x-mail-sync-secret) and the optional Zoho webhook
# (/api/mail/webhook?secret=...). Use a long random string. Vercel Cron and the Cloudflare cron can also use CRON_SECRET.
MAIL_SYNC_SECRET=

# Local development only: lets the mail UI preview work without logging in. Ignored in production builds.
# MAIL_DEV_BYPASS_AUTH=true
